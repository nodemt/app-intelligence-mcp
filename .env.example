# Export these variables before launching the application, or set them in
# your local MCP client configuration (Codex CLI, Claude Code, Cursor, or another stdio client).
# The application reads environment variables at startup.

# Astro must be running locally with its MCP server enabled.
ASTRO_MCP_ENDPOINT=http://127.0.0.1:8089/mcp

# Optional Mixpanel MCP integration. Set both values to enable
# get_saved_product_report and get_app_intelligence.
# Example EU MCP endpoint: https://mcp-eu.mixpanel.com/mcp
# Run the binary with mixpanel-login and the same endpoint before launching
# the MCP server. Repeat the login when the access token expires.
MIXPANEL_MCP_ENDPOINT=
MIXPANEL_PROJECT_ID=

# Direct Query API configuration. Leave MIXPANEL_MCP_ENDPOINT unset and set
# MIXPANEL_PROJECT_ID plus the three variables below. Requires Query API access.
# Example EU query endpoint: https://eu.mixpanel.com/api/query/insights
MIXPANEL_QUERY_ENDPOINT=
MIXPANEL_SERVICE_ACCOUNT_USERNAME=
MIXPANEL_SERVICE_ACCOUNT_SECRET=
