# Export these variables before launching the application, or set them in the MCP client configuration.
# The application reads environment variables at startup.

# Astro must be running locally with its MCP server enabled.
ASTRO_MCP_ENDPOINT=http://127.0.0.1:8089/mcp

# Optional Mixpanel integration. Set all four values to enable get_saved_product_report.
# Example EU query endpoint: https://eu.mixpanel.com/api/query/insights
MIXPANEL_QUERY_ENDPOINT=
MIXPANEL_SERVICE_ACCOUNT_USERNAME=
MIXPANEL_SERVICE_ACCOUNT_SECRET=
MIXPANEL_PROJECT_ID=
